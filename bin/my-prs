#!/bin/sh
# Every open pull request you authored, across all repositories, with its CI
# state and the names of failing checks. Read-only.
#
# Pull requests are paged until none are left. Checks are read 100 per pull
# request; a pull request with more is marked "checks=partial" so its failing
# list is never mistaken for the whole story.
exec gh api graphql --paginate -f query='
query($endCursor: String) {
  viewer {
    pullRequests(first: 50, after: $endCursor, states: OPEN, orderBy: {field: UPDATED_AT, direction: DESC}) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number
        title
        isDraft
        reviewDecision
        repository { nameWithOwner }
        commits(last: 1) {
          nodes {
            commit {
              statusCheckRollup {
                state
                contexts(first: 100) {
                  pageInfo { hasNextPage }
                  nodes {
                    ... on CheckRun { name conclusion }
                    ... on StatusContext { context state }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}' --jq '
.data.viewer.pullRequests.nodes[]
| (.commits.nodes[0].commit.statusCheckRollup) as $ci
| [
    .repository.nameWithOwner + "#" + (.number | tostring),
    (if .isDraft then "draft" else "ready" end),
    "ci=" + ($ci.state // "NONE"),
    "review=" + (.reviewDecision // "NONE"),
    "failing=" + ([$ci.contexts.nodes[]?
        | select((.conclusion // .state) as $s
            | ["FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED"] | index($s))
        | (.name // .context)] | join(","))
      + (if $ci.contexts.pageInfo.hasNextPage then " (checks=partial: over 100 checks, more may be failing)" else "" end),
    .title
  ] | join(" | ")'
